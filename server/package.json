{
  "name": "chat-server",
  "version": "0.1.0",
  "private": true,
  "description": "Game-help chat API: a controlled Gemini proxy for the PSN stats site, plus a static server for the built site.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    "./contract": "./src/contract.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsup"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "eslint": "^10.7.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  }
}
